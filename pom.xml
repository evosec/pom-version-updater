<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
    </parent>

    <groupId>de.evosec</groupId>
    <artifactId>pom-version-updater</artifactId>
    <version>0.0.8-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <!-- jgitflow -->
        <jgitflow.developBranchName>develop</jgitflow.developBranchName>
        <jgitflow.masterBranchName>master</jgitflow.masterBranchName>
        <jgitflow.pushReleases>false</jgitflow.pushReleases>
        <jgitflow.pushHotfixes>false</jgitflow.pushHotfixes>
        <jgitflow.noDeploy>false</jgitflow.noDeploy>
        <jgitflow.noReleaseBuild>true</jgitflow.noReleaseBuild>
        <jgitflow.noFeatureBuild>true</jgitflow.noFeatureBuild>
        <jgitflow.noHotfixBuild>true</jgitflow.noHotfixBuild>
        <jgitflow.username>not-configured</jgitflow.username>
        <jgitflow.password>not-configured</jgitflow.password>
        <jgitflow.developmentVersion/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>1.21.1</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>7.3.0.202506031305-r</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <executable>true</executable>
                    <embeddedLaunchScript>${project.basedir}/src/main/resources/launch.script</embeddedLaunchScript>
                </configuration>
            </plugin>
            <plugin>
                <groupId>external.atlassian.jgitflow</groupId>
                <artifactId>jgitflow-maven-plugin</artifactId>
                <version>1.0-m5.1</version>
                <configuration>
                    <flowInitContext>
                        <developBranchName>${jgitflow.developBranchName}</developBranchName>
                        <masterBranchName>${jgitflow.masterBranchName}</masterBranchName>
                    </flowInitContext>
                    <pushReleases>${jgitflow.pushReleases}</pushReleases>
                    <pushHotfixes>${jgitflow.pushHotfixes}</pushHotfixes>
                    <noDeploy>${jgitflow.noDeploy}</noDeploy>
                    <noReleaseBuild>${jgitflow.noReleaseBuild}</noReleaseBuild>
                    <noFeatureBuild>${jgitflow.noFeatureBuild}</noFeatureBuild>
                    <noHotfixBuild>${jgitflow.noHotfixBuild}</noHotfixBuild>
                    <developmentVersion>${jgitflow.developmentVersion}</developmentVersion>
                    <useReleaseProfile>false</useReleaseProfile>
                    <username>${jgitflow.username}</username>
                    <password>${jgitflow.password}</password>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
